# ── AI (required for cloud, optional locally) ──────────────────────────────────
# Free key at: https://console.groq.com
GROQ_API_KEY=

# ── Database (leave blank to use local SQLite) ─────────────────────────────────
# Supabase: Settings → Database → Connection string (URI mode)
DATABASE_URL=

# ── File Storage (leave blank to use local disk) ───────────────────────────────
# Supabase: Settings → API → Project URL
SUPABASE_URL=
# Supabase: Settings → API → service_role key (NOT anon key)
SUPABASE_SERVICE_KEY=

# ── Sign in with Google (optional) ─────────────────────────────────────────────
# Lets each person keep their own private notebook, reminders and goals across
# devices. Create an OAuth "Web application" client ID at
# https://console.cloud.google.com/apis/credentials and add your site's URL
# (e.g. https://your-app.vercel.app and http://localhost:5173) under
# "Authorized JavaScript origins". Leave blank to run in this-device-only mode.
GOOGLE_CLIENT_ID=
